<jsp:include page="/inc/top.jsp" /><main class="w-full flex-1 flex flex-col items-center justify-center p-gutter-mobile sm:p-gutter-desktop"><div class="flex flex-col w-full">
<div class="w-full max-w-[960px] mx-auto my-auto shadow-xl rounded-2xl overflow-hidden flex flex-col md:flex-row bg-surface-container-lowest">
<!-- Left Column: Dark Navy Brand Panel -->
<div class="w-full md:w-[45%] bg-primary-container p-8 lg:p-12 flex flex-col justify-between relative overflow-hidden text-on-primary">
<!-- Subtle Decorative Tech Grid Pattern Overlay -->
<div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: radial-gradient(#3f69f1 1px, transparent 1px); background-size: 20px 20px;"></div>
<div class="absolute -top-24 -left-24 w-64 h-64 bg-secondary/20 rounded-full blur-3xl pointer-events-none"></div>
<div class="absolute -bottom-20 -right-20 w-64 h-64 bg-secondary-container/25 rounded-full blur-3xl pointer-events-none"></div>
